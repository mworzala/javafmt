class Session {
    // Trailing comments on constructor parameters.
    Session(List<Interceptor> interceptors, //
        Supplier<Listener> listenerSupplier, //
        Function<Store, Launcher> launcherFactory) {
    }

    // Leading comment on a method parameter.
    void f(
