class Example {
    // Trailing-lambda idiom (preferred when its first line fits):
    //   call(arg1, arg2, params -> {
    //       body
    //   });
    // The first line `call(arg1, arg2, params -> {` fits, so the args stay
    // inline and the lambda's block body uses its own newlines. The closing
    // `})` glues together at the call's base indent.
    void registerInteraction() {
        this.interactionEntity.setTag(NpcHandler.TAG, (player, npc, hand, isLeftHand) -> {
            if (!BaseNpcEntity.this.hasTag(NpcHandler.TAG)) return;
            BaseNpcEntity.this.getTag(NpcHandler.TAG).handlePlayerInteract(player, BaseNpcEntity.this, hand, isLeftHand);
        });
    }

    // Two non-lambda args plus a trailing lambda — first line fits, trailing-lambda.
    void threeArgs() {
        registerHandler(EventKind.JOIN, Priority.NORMAL, event -> {
            doFirst(event);
            doSecond(event);
        });
    }

    // Trailing-lambda first line DOESN'T fit (header too wide) — fall back to
    // the wrap-all shape: each arg on its own indented line, `)` on its own line.
    void firstLineDoesntFit() {
        registerWithVeryLongNameSomeKind(SomeOtherLongConstantName.VALUE, AnotherLongConstant.OTHER, event -> {
            doFirst(event);
        });
    }

    // Single-arg trailing lambda call that fits inline — should stay one line.
    void singleArgInline() {
        list.forEach(item -> item.process());
    }

    // Single-arg lambda where only the lambda is the arg AND its body is a
    // block. The single-arg path glues `});` together — the conventional
    // trailing-call idiom for Stream-style APIs (forEach, execute, etc.) which
    // we deliberately preserve.
    void singleArgBlock() {
        runnable.execute(() -> {
            stepOne();
            stepTwo();
        });
    }

    // Trailing anonymous class — same rule. First line fits, use trailing form.
    void anonClass() {
        registry.register(Topic.JOIN, new EventHandler<Event>() {
            @Override
            public void handle(Event event) {
                doSomething(event);
            }
        });
    }

    // Trailing switch expression — same rule.
    void switchExprArg(int kind) {
        reporter.report(Severity.INFO, switch (kind) {
            case 0 -> "zero";
            case 1 -> "one";
            default -> "many";
        });
    }

    // No regression on plain wrapping: a call with no block-like trailing arg
    // breaks all args symmetrically.
    void plainWrap() {
        compute(firstArgumentNameHere, secondArgumentNameHere, thirdArgumentNameHere, fourthArgumentNameHere);
    }
}
---
class Example {
    // Trailing-lambda idiom (preferred when its first line fits):
    //   call(arg1, arg2, params -> {
    //       body
    //   });
    // The first line `call(arg1, arg2, params -> {` fits, so the args stay
    // inline and the lambda's block body uses its own newlines. The closing
    // `})` glues together at the call's base indent.
    void registerInteraction() {
        this.interactionEntity.setTag(NpcHandler.TAG, (player, npc, hand, isLeftHand) -> {
            if (!BaseNpcEntity.this.hasTag(NpcHandler.TAG)) return;
            BaseNpcEntity.this.getTag(NpcHandler.TAG)
                .handlePlayerInteract(player, BaseNpcEntity.this, hand, isLeftHand);
        });
    }

    // Two non-lambda args plus a trailing lambda — first line fits, trailing-lambda.
    void threeArgs() {
        registerHandler(EventKind.JOIN, Priority.NORMAL, event -> {
            doFirst(event);
            doSecond(event);
        });
    }

    // Trailing-lambda first line DOESN'T fit (header too wide) — fall back to
    // the wrap-all shape: each arg on its own indented line, `)` on its own line.
    void firstLineDoesntFit() {
        registerWithVeryLongNameSomeKind(
            SomeOtherLongConstantName.VALUE,
            AnotherLongConstant.OTHER,
            event -> {
                doFirst(event);
            }
        );
    }

    // Single-arg trailing lambda call that fits inline — should stay one line.
    void singleArgInline() {
        list.forEach(item -> item.process());
    }

    // Single-arg lambda where only the lambda is the arg AND its body is a
    // block. The single-arg path glues `});` together — the conventional
    // trailing-call idiom for Stream-style APIs (forEach, execute, etc.) which
    // we deliberately preserve.
    void singleArgBlock() {
        runnable.execute(() -> {
            stepOne();
            stepTwo();
        });
    }

    // Trailing anonymous class — same rule. First line fits, use trailing form.
    void anonClass() {
        registry.register(Topic.JOIN, new EventHandler<Event>() {
            @Override
            public void handle(Event event) {
                doSomething(event);
            }
        });
    }

    // Trailing switch expression — same rule.
    void switchExprArg(int kind) {
        reporter.report(Severity.INFO, switch (kind) {
            case 0 -> "zero";
            case 1 -> "one";
            default -> "many";
        });
    }

    // No regression on plain wrapping: a call with no block-like trailing arg
    // breaks all args symmetrically.
    void plainWrap() {
        compute(
            firstArgumentNameHere,
            secondArgumentNameHere,
            thirdArgumentNameHere,
            fourthArgumentNameHere
        );
    }
}
