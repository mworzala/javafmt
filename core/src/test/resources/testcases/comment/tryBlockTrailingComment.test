        try {
            risky();
        } // @formatter:on
        catch (Exception ex) {
            handle(ex);
        }
    }

    // Comment-free try/catch/finally stays glued.
    void plain() {
        try {
            risky();
        } catch (Exception ex) {
            handle(ex);
        } finally {
            cleanup();
        }
    }
}
